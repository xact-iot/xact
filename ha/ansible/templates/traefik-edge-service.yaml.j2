apiVersion: v1
kind: Service
metadata:
  name: traefik-edge
  namespace: kube-system
  labels:
    app.kubernetes.io/name: traefik
    app.kubernetes.io/component: edge-nodeport
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: traefik
  ports:
    - name: web
      port: 80
      targetPort: web
      nodePort: {{ edge_traefik_http_node_port }}
    - name: websecure
      port: 443
      targetPort: websecure
      nodePort: {{ edge_traefik_https_node_port }}
